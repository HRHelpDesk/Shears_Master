{
  "name": "ShearsMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=shearDebug --appId=com.shears.shear",
    "android:shear": "react-native run-android --mode=shearDebug --appId=com.shears.shear",
    "android:purpose": "react-native run-android --mode=purposeDebug --appId=com.shears.purpose",
    "android:bossCrowns": "react-native run-android --mode=bossCrownsDebug --appId=com.bosscrowns.bcia",
    "build:shear:debug": "cd android && ./gradlew assembleShearDebug",
    "build:shear:release": "cd android && ./gradlew assembleShearRelease",
    "build:purpose:debug": "cd android && ./gradlew assemblePurposeDebug",
    "build:purpose:release": "cd android && ./gradlew assemblePurposeRelease",
    "build:bossCrowns:debug": "cd android && ./gradlew assembleBossCrownsDebug",
    "build:bossCrowns:release": "cd android && ./gradlew assembleBossCrownsRelease",
    "install:shear:debug": "cd android && ./gradlew installShearDebug",
    "install:purpose:debug": "cd android && ./gradlew installPurposeDebug",
    "install:bossCrowns:debug": "cd android && ./gradlew installBossCrownsDebug",
    "install:bossCrowns:release": "cd android && ./gradlew installBossCrownsRelease",
    "deploy:shear:debug": "cd android && ./gradlew assembleShearDebug installShearDebug",
    "deploy:purpose:debug": "cd android && ./gradlew assemblePurposeDebug installPurposeDebug",
    "deploy:bossCrowns:debug": "cd android && ./gradlew assembleBossCrownsDebug installBossCrownsDebug",
    "bundle:shear:release":   "cd android && ./gradlew bundleShearRelease",
  "bundle:purpose:release": "cd android && ./gradlew bundlePurposeRelease",
  "bundle:bossCrowns:release": "cd android && ./gradlew bundleBossCrownsRelease",
    "ios": "react-native run-ios",
    "start": "react-native start --reset-cache",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^0.12.2",
    "@callstack/liquid-glass": "^0.4.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.5",
    "@react-native-documents/picker": "^12.0.1",
    "@react-navigation/bottom-tabs": "7.4.9",
    "@react-navigation/drawer": "^7.7.0",
    "@react-navigation/material-top-tabs": "^7.3.8",
    "@react-navigation/native": "7.1.18",
    "@react-navigation/native-stack": "7.3.28",
    "@stripe/stripe-react-native": "^0.55.1",
    "@stripe/stripe-terminal-react-native": "^0.0.1-beta.27",
    "date-fns": "^4.1.0",
    "papaparse": "^5.5.3",
    "react": "19.1.1",
    "react-native": "0.82.0",
    "react-native-bottom-tabs": "^0.12.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.29.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "2.8.3",
    "react-native-pager-view": "^6.9.1",
    "react-native-paper": "5.14.5",
    "react-native-portalize": "^1.0.7",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.17.1",
    "react-native-sfsymbols": "1.2.2",
    "react-native-svg": "^15.15.0",
    "react-native-tab-view": "^4.1.3",
    "react-native-uuid": "^2.0.3",
    "react-native-vector-icons": "10.3.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.6.1",
    "sharp": "^0.34.5",
    "shears-shared": "1.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.0",
    "@react-native/eslint-config": "0.82.0",
    "@react-native/metro-config": "0.82.0",
    "@react-native/typescript-config": "0.82.0",
    "@types/jest": "29.5.13",
    "@types/react": "19.1.1",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.19.0",
    "jest": "29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
